# Puerto en el que escucha el servidor Express
PORT=3000

# Cadena de conexión a MongoDB Atlas
# Reemplazar <usuario>, <password> y <cluster> por los valores reales del cluster
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/admision_2026?retryWrites=true&w=majority

# Secreto para la firma de JSON Web Tokens
JWT_SECRET=cambia_este_valor_por_un_secreto_seguro
JWT_EXPIRES_IN=8h

# Entorno de ejecución
NODE_ENV=development

# --- Correo real (Nodemailer + Gmail SMTP) para verificación de cuenta ---
# EMAIL_USER: cuenta de Gmail que enviará los correos (ej: admision2026@gmail.com)
# EMAIL_PASS: "Contraseña de aplicación" de Google (NO la contraseña normal de Gmail).
#   Generar en: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo_del_proyecto@gmail.com
EMAIL_PASS=contraseña_de_aplicacion_de_16_caracteres
EMAIL_FROM="Admisión 2026 <tu_correo_del_proyecto@gmail.com>"

# URL del frontend, para armar el enlace de verificación que se envía por correo
CLIENT_URL=http://localhost:5173
